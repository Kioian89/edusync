rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function activityTeacher(activityId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/activities/$(activityId))
          .data.teacherId == request.auth.uid;
    }

    function classTeacher(classId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/classes/$(classId))
          .data.teacherId == request.auth.uid;
    }

    function classMember(classId) {
      let classGroup = get(
        /databases/$(database)/documents/classes/$(classId)
      ).data;
      return isAuthenticated()
        && (
          classGroup.teacherId == request.auth.uid
          || request.auth.uid in classGroup.studentIds
        );
    }

    function activityStudent(activityId, studentId) {
      let activity = get(
        /databases/$(database)/documents/activities/$(activityId)
      ).data;
      let classGroup = get(
        /databases/$(database)/documents/classes/$(activity.classId)
      ).data;
      return isAuthenticated()
        && request.auth.uid == studentId
        && studentId in classGroup.studentIds;
    }

    function isSelfEnrollment() {
      return isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['studentIds'])
        && resource.data.get('studentIds', []).size()
          < resource.data.get('maxStudents', 30)
        && request.resource.data.studentIds.size()
          == resource.data.studentIds.size() + 1
        && request.resource.data.studentIds.hasAll(resource.data.studentIds)
        && request.auth.uid in request.resource.data.studentIds;
    }

    function validClassCapacity(classData) {
      let capacity = classData.get('maxStudents', 30);
      let students = classData.get('studentIds', []);
      return capacity is int
        && capacity >= 1
        && capacity <= 500
        && students is list
        && students.size() <= capacity;
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------------------
    match /users/{userId} {
      // These documents contain roster metadata only. Personal profile details and
      // email addresses are stored in the owner-only private profile document.
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'role',
          'classId',
          'enrolledClassIds',
          'photoUrl',
          'profileComplete',
          'updatedAt'
        ]);
      allow delete: if isOwner(userId);

      match /private/{documentId} {
        // Email, birthdays, and student/employee identifiers are private to the owner.
        allow read, write: if isOwner(userId);
      }
    }

    // -------------------------------------------------------------------------
    // CLASSES COLLECTION
    // -------------------------------------------------------------------------
    match /classes/{classId} {
      // Authenticated users can read classes
      allow read: if isAuthenticated();
      // Only teachers or class creators can create/update/delete classes
      allow create: if isAuthenticated()
        && request.resource.data.teacherId == request.auth.uid
        && validClassCapacity(request.resource.data);
      allow update: if isAuthenticated()
        && (
          (
            resource.data.teacherId == request.auth.uid
            && request.resource.data.teacherId == resource.data.teacherId
            && validClassCapacity(request.resource.data)
          )
          || isSelfEnrollment()
        );
      allow delete: if isAuthenticated() && resource.data.teacherId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // ACTIVITIES COLLECTION
    // -------------------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isAuthenticated() && classMember(resource.data.classId);
      allow create: if isAuthenticated()
        && request.resource.data.teacherId == request.auth.uid
        && (
          !exists(/databases/$(database)/documents/classes/$(request.resource.data.classId))
          || get(/databases/$(database)/documents/classes/$(request.resource.data.classId)).data.teacherId == request.auth.uid
        );
      allow update: if isAuthenticated()
        && resource.data.teacherId == request.auth.uid
        && request.resource.data.teacherId == resource.data.teacherId;
      allow delete: if isAuthenticated()
        && resource.data.teacherId == request.auth.uid;

      match /teacher_private/{documentId} {
        allow read: if activityTeacher(activityId);
        allow write: if isAuthenticated()
          && (
            activityTeacher(activityId)
            || request.resource.data.teacherId == request.auth.uid
            || resource == null
          );
      }
    }

    // -------------------------------------------------------------------------
    // SUBMISSIONS COLLECTION
    // -------------------------------------------------------------------------
    match /submissions/{submissionId} {
      // Students can read their own work; teachers can read their class submissions.
      allow read: if isAuthenticated()
        && (
          request.auth.uid == resource.data.studentId
          || activityTeacher(resource.data.activityId)
        );

      // Student can create their submission attempt; teachers can create/assign.
      allow create: if isAuthenticated()
        && (
          request.auth.uid == request.resource.data.studentId
          || activityTeacher(request.resource.data.activityId)
        );

      // Students can update their own submission (excluding grade/feedback),
      // and teachers can grade or update.
      allow update: if isAuthenticated()
        && (
          activityTeacher(resource.data.activityId)
          || (
            request.auth.uid == resource.data.studentId
            && request.resource.data.studentId == resource.data.studentId
            && request.resource.data.activityId == resource.data.activityId
            && request.resource.data.get('grade', null) == resource.data.get('grade', null)
            && request.resource.data.get('feedback', null) == resource.data.get('feedback', null)
          )
        );

      allow delete: if isAuthenticated()
        && (
          request.auth.uid == resource.data.studentId
          || activityTeacher(resource.data.activityId)
        );
    }

    // -------------------------------------------------------------------------
    // ANNOUNCEMENTS COLLECTION
    // -------------------------------------------------------------------------
    match /announcements/{announcementId} {
      allow read: if isAuthenticated() && classMember(resource.data.classId);
      allow create: if classTeacher(request.resource.data.classId);
      allow update: if classTeacher(resource.data.classId)
        && request.resource.data.classId == resource.data.classId;
      allow delete: if classTeacher(resource.data.classId);
    }

    // -------------------------------------------------------------------------
    // CONFIGURATION (e.g. Gemini AI Settings)
    // -------------------------------------------------------------------------
    match /config/{configId} {
      // Shared AI configuration may contain provider credentials.
      allow read, write: if isAuthenticated()
        && request.auth.token.edusync_role == 'teacher';
    }

    // -------------------------------------------------------------------------
    // AI CHAT HISTORY
    // -------------------------------------------------------------------------
    match /ai_history/{userId}/messages/{messageId} {
      allow read, write: if isOwner(userId);
    }
  }
}
